# SMTP Configuration (leave blank for development fallback mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Application Base URL (used for activation/reset links in emails)
APP_BASE_URL=http://127.0.0.1:8000

# JWT Authentication
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie security (set to true for HTTPS deployments)
SECURE_COOKIES=false

# Environment (set to "production" in deployment)
ENV=development

# Port (Cloud Run sets this automatically)
PORT=8000

# Groq AI (for intervention generation)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
